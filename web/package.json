{
  "name": "tiny-compiler-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "python3 ../scripts/build_web.py",
    "dev": "astro dev",
    "prebuild": "python3 ../scripts/build_web.py",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "python3 ../scripts/build_web.py && astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "@codemirror/state": "^6.7.6",
    "astro": "^5.0.0",
    "codemirror": "^6.0.2",
    "framer-motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.48.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  }
}
