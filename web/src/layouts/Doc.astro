---
import Base from "./Base.astro";
const { frontmatter } = Astro.props;
---
<Base title={`${frontmatter.title} · TinyCompiler docs`} description={frontmatter.description}>
  <main class="doc">
    <nav class="muted"><a href="/docs/">Docs</a> · <a href="/app">Explorer</a> · <a href="/">Home</a></nav>
    <h1>{frontmatter.title}</h1>
    <article><slot /></article>
  </main>
  <style>
    .doc { max-width: 860px; }
    .doc article :global(table) { display: block; overflow-x: auto; }
    .doc article :global(pre) { max-width: 100%; }
    .doc article :global(h2) { margin-top: 28px; font-size: 19px; }
    .doc article :global(h3) { font-size: 16px; }
    .doc article :global(code) { font-family: ui-monospace, Menlo, monospace; font-size: 0.92em; }
    .doc article :global(p code), .doc article :global(li code) { background: var(--code-bg); padding: 1px 4px; border-radius: 4px; }
  </style>
</Base>
