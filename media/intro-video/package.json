    "still": "remotion still src/index.ts TinyCompilerIntro"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.541",
    "@remotion/google-fonts": "^4.0.541",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.541",
    "typescript": "^7.0.2"
  }
}
