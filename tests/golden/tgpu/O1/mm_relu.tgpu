; kernel k0_matmul: %1 = matmul  (t.tiny:4:5)
; grid: 4 blocks x 4 threads; 6 registers (R5-R7 reserved, read-only)
SET R0, 0       ; 4:5
MUL R1, R5, 8   ; 4:5
ADD R1, R1, 0   ; 4:5
ADD R2, R6, 32  ; 4:5
SET R3, 0       ; 4:5
L0:
ADD R4, R1, R3  ; 4:5
LD R4, R4       ; 4:5
LD R8, R2       ; 4:5
MUL R4, R4, R8  ; 4:5
ADD R0, R0, R4  ; 4:5
ADD R2, R2, 4   ; 4:5
ADD R3, R3, 1   ; 4:5
CMP R3, 8       ; 4:5
BRLT L0         ; 4:5
CMP R0, 0       ; 4:5
BRGT L1         ; 4:5
SET R0, 0       ; 4:5
L1:
ADD R1, R7, 64  ; 4:5
ST R1, R0       ; 4:5
