; kernel k0_matmul: %0 = matmul  (t.tiny:4:10)
; grid: 12 blocks x 12 threads; 4 registers (R5-R7 reserved, read-only)
SET R0, 0        ; 4:10
SET R1, 0        ; 4:10
L0:
MUL R2, R5, 12   ; 4:10
ADD R2, R2, 0    ; 4:10
ADD R2, R2, R1   ; 4:10
LD R2, R2        ; 4:10
MUL R3, R1, 12   ; 4:10
ADD R3, R3, R6   ; 4:10
ADD R3, R3, 144  ; 4:10
LD R3, R3        ; 4:10
MUL R2, R2, R3   ; 4:10
ADD R0, R0, R2   ; 4:10
ADD R1, R1, 1    ; 4:10
CMP R1, 12       ; 4:10
BRLT L0          ; 4:10
ADD R1, R7, 288  ; 4:10
ST R1, R0        ; 4:10

; kernel k1_relu: %1 = relu  (t.tiny:4:5)
; grid: 12 blocks x 12 threads; 2 registers (R5-R7 reserved, read-only)
ADD R0, R7, 288  ; 4:5
LD R0, R0        ; 4:5
CMP R0, 0        ; 4:5
BRGT L0          ; 4:5
SET R0, 0        ; 4:5
L0:
ADD R1, R7, 432  ; 4:5
ST R1, R0        ; 4:5
