; kernel k0_matmul: %0 = matmul  (t.tiny:6:10)
; grid: 4 blocks x 6 threads; 4 registers (R5-R7 reserved, read-only)
SET R0, 0        ; 6:10
SET R1, 0        ; 6:10
L0:
MUL R2, R5, 8    ; 6:10
ADD R2, R2, 0    ; 6:10
ADD R2, R2, R1   ; 6:10
LD R2, R2        ; 6:10
MUL R3, R1, 6    ; 6:10
ADD R3, R3, R6   ; 6:10
ADD R3, R3, 32   ; 6:10
LD R3, R3        ; 6:10
MUL R2, R2, R3   ; 6:10
ADD R0, R0, R2   ; 6:10
ADD R1, R1, 1    ; 6:10
CMP R1, 8        ; 6:10
BRLT L0          ; 6:10
ADD R1, R7, 104  ; 6:10
ST R1, R0        ; 6:10

; kernel k1_add: %1 = add  (t.tiny:6:10)
; grid: 4 blocks x 6 threads; 2 registers (R5-R7 reserved, read-only)
ADD R0, R7, 104  ; 6:10
LD R0, R0        ; 6:10
ADD R1, R6, 80   ; 6:10
LD R1, R1        ; 6:10
ADD R0, R0, R1   ; 6:10
ADD R1, R7, 128  ; 6:10
ST R1, R0        ; 6:10

; kernel k2_relu: %2 = relu  (t.tiny:6:5)
; grid: 4 blocks x 6 threads; 2 registers (R5-R7 reserved, read-only)
ADD R0, R7, 128  ; 6:5
LD R0, R0        ; 6:5
CMP R0, 0        ; 6:5
BRGT L0          ; 6:5
SET R0, 0        ; 6:5
L0:
ADD R1, R7, 104  ; 6:5
ST R1, R0        ; 6:5

; kernel k3_matmul: %3 = matmul  (t.tiny:7:5)
; grid: 4 blocks x 3 threads; 4 registers (R5-R7 reserved, read-only)
SET R0, 0        ; 7:5
SET R1, 0        ; 7:5
L0:
MUL R2, R5, 6    ; 7:5
ADD R2, R2, 104  ; 7:5
ADD R2, R2, R1   ; 7:5
LD R2, R2        ; 7:5
MUL R3, R1, 3    ; 7:5
ADD R3, R3, R6   ; 7:5
ADD R3, R3, 86   ; 7:5
LD R3, R3        ; 7:5
MUL R2, R2, R3   ; 7:5
ADD R0, R0, R2   ; 7:5
ADD R1, R1, 1    ; 7:5
CMP R1, 6        ; 7:5
BRLT L0          ; 7:5
ADD R1, R7, 128  ; 7:5
ST R1, R0        ; 7:5
