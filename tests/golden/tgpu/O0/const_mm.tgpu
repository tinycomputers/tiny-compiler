; kernel k0_matmul: %1 = matmul  (t.tiny:5:10)
; grid: 3 blocks x 2 threads; 4 registers (R5-R7 reserved, read-only)
SET R0, 0       ; 5:10
SET R1, 0       ; 5:10
L0:
MUL R2, R5, 2   ; 5:10
ADD R2, R2, 0   ; 5:10
ADD R2, R2, R1  ; 5:10
LD R2, R2       ; 5:10
MUL R3, R1, 2   ; 5:10
ADD R3, R3, R6  ; 5:10
ADD R3, R3, 6   ; 5:10
LD R3, R3       ; 5:10
MUL R2, R2, R3  ; 5:10
ADD R0, R0, R2  ; 5:10
ADD R1, R1, 1   ; 5:10
CMP R1, 2       ; 5:10
BRLT L0         ; 5:10
ADD R1, R7, 10  ; 5:10
ST R1, R0       ; 5:10

; kernel k1_relu: %2 = relu  (t.tiny:5:5)
; grid: 3 blocks x 2 threads; 2 registers (R5-R7 reserved, read-only)
ADD R0, R7, 10  ; 5:5
LD R0, R0       ; 5:5
CMP R0, 0       ; 5:5
BRGT L0         ; 5:5
SET R0, 0       ; 5:5
L0:
ADD R1, R7, 16  ; 5:5
ST R1, R0       ; 5:5
