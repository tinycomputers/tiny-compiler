; kernel k0_matmul: %0 = matmul  (t.tiny:4:5)
; grid: 4 blocks x 4 threads; 4 registers (R5-R7 reserved, read-only)
SET R0, 0       ; 4:5
SET R1, 0       ; 4:5
L0:
MUL R2, R5, 4   ; 4:5
ADD R2, R2, 0   ; 4:5
ADD R2, R2, R1  ; 4:5
LD R2, R2       ; 4:5
MUL R3, R1, 4   ; 4:5
ADD R3, R3, R6  ; 4:5
ADD R3, R3, 16  ; 4:5
LD R3, R3       ; 4:5
MUL R2, R2, R3  ; 4:5
ADD R0, R0, R2  ; 4:5
ADD R1, R1, 1   ; 4:5
CMP R1, 4       ; 4:5
BRLT L0         ; 4:5
ADD R1, R7, 32  ; 4:5
ST R1, R0       ; 4:5
