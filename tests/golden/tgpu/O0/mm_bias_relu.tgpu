; kernel k0_matmul: %0 = matmul  (t.tiny:5:10)
; grid: 4 blocks x 4 threads; 4 registers (R5-R7 reserved, read-only)
SET R0, 0       ; 5:10
SET R1, 0       ; 5:10
L0:
MUL R2, R5, 8   ; 5:10
ADD R2, R2, 0   ; 5:10
ADD R2, R2, R1  ; 5:10
LD R2, R2       ; 5:10
MUL R3, R1, 4   ; 5:10
ADD R3, R3, R6  ; 5:10
ADD R3, R3, 32  ; 5:10
LD R3, R3       ; 5:10
MUL R2, R2, R3  ; 5:10
ADD R0, R0, R2  ; 5:10
ADD R1, R1, 1   ; 5:10
CMP R1, 8       ; 5:10
BRLT L0         ; 5:10
ADD R1, R7, 68  ; 5:10
ST R1, R0       ; 5:10

; kernel k1_add: %1 = add  (t.tiny:5:10)
; grid: 4 blocks x 4 threads; 2 registers (R5-R7 reserved, read-only)
ADD R0, R7, 68  ; 5:10
LD R0, R0       ; 5:10
ADD R1, R6, 64  ; 5:10
LD R1, R1       ; 5:10
ADD R0, R0, R1  ; 5:10
ADD R1, R7, 84  ; 5:10
ST R1, R0       ; 5:10

; kernel k2_relu: %2 = relu  (t.tiny:5:5)
; grid: 4 blocks x 4 threads; 2 registers (R5-R7 reserved, read-only)
ADD R0, R7, 84  ; 5:5
LD R0, R0       ; 5:5
CMP R0, 0       ; 5:5
BRGT L0         ; 5:5
SET R0, 0       ; 5:5
L0:
ADD R1, R7, 68  ; 5:5
ST R1, R0       ; 5:5
