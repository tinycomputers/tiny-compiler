; kernel k0_matmul: %2 = matmul  (t.tiny:5:5)
; grid: 4 blocks x 4 threads; 4 registers (R5-R7 reserved, read-only)
SET R0, 0       ; 5:5
SET R1, 0       ; 5:5
L0:
MUL R2, R5, 8   ; 5:5
ADD R2, R2, R1  ; 5:5
ADD R2, R2, 0   ; 5:5
LD R2, R2       ; 5:5
MUL R3, R1, 4   ; 5:5
ADD R3, R3, R6  ; 5:5
ADD R3, R3, 32  ; 5:5
LD R3, R3       ; 5:5
MUL R2, R2, R3  ; 5:5
ADD R0, R0, R2  ; 5:5
ADD R1, R1, 1   ; 5:5
CMP R1, 8       ; 5:5
BRLT L0         ; 5:5
ADD R1, R6, 64  ; 5:5
LD R1, R1       ; 5:5
ADD R0, R0, R1  ; 5:5
CMP R0, 0       ; 5:5
BRGT L1         ; 5:5
SET R0, 0       ; 5:5
L1:
ADD R1, R7, 68  ; 5:5
ST R1, R0       ; 5:5
