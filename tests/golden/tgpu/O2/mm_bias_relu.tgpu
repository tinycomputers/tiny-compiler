; kernel k0_matmul: %2 = matmul  (t.tiny:5:5)
; grid: 4 blocks x 4 threads; 8 shared words per block; 5 registers (R5-R7 reserved, read-only)
SET R0, 0       ; 5:5
MUL R1, R5, 8   ; 5:5
ADD R2, R6, 32  ; 5:5
ADD R3, R1, R6  ; 5:5
LD R3, R3       ; 5:5
SHST R6, R3     ; 5:5
ADD R3, R6, 4   ; 5:5
ADD R1, R1, R3  ; 5:5
LD R1, R1       ; 5:5
SHST R3, R1     ; 5:5
SYNCB           ; 5:5
SHLD R1, 0      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
SHLD R1, 1      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
SHLD R1, 2      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
SHLD R1, 3      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
SHLD R1, 4      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
SHLD R1, 5      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
SHLD R1, 6      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
SHLD R1, 7      ; 5:5
LD R3, R2       ; 5:5
MUL R4, R1, R3  ; 5:5
ADD R0, R0, R4  ; 5:5
ADD R2, R2, 4   ; 5:5
ADD R1, R6, 64  ; 5:5
LD R1, R1       ; 5:5
ADD R0, R0, R1  ; 5:5
CMP R0, 0       ; 5:5
BRGT L0         ; 5:5
SET R0, 0       ; 5:5
L0:
ADD R1, R7, 68  ; 5:5
ST R1, R0       ; 5:5
