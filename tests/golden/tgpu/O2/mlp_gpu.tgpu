; kernel k0_matmul: %2 = matmul  (t.tiny:6:5)
; grid: 4 blocks x 6 threads; 8 shared words per block; 5 registers (R5-R7 reserved, read-only)
SET R0, 0        ; 6:5
MUL R1, R5, 8    ; 6:5
ADD R2, R6, 32   ; 6:5
ADD R3, R1, R6   ; 6:5
LD R3, R3        ; 6:5
SHST R6, R3      ; 6:5
ADD R3, R6, 6    ; 6:5
CMP R3, 7        ; 6:5
BRGT L0          ; 6:5
ADD R1, R1, R3   ; 6:5
LD R1, R1        ; 6:5
SHST R3, R1      ; 6:5
L0:
SYNCB            ; 6:5
SHLD R1, 0       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
SHLD R1, 1       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
SHLD R1, 2       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
SHLD R1, 3       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
SHLD R1, 4       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
SHLD R1, 5       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
SHLD R1, 6       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
SHLD R1, 7       ; 6:5
LD R3, R2        ; 6:5
MUL R4, R1, R3   ; 6:5
ADD R0, R0, R4   ; 6:5
ADD R2, R2, 6    ; 6:5
ADD R1, R6, 80   ; 6:5
LD R1, R1        ; 6:5
ADD R0, R0, R1   ; 6:5
CMP R0, 0        ; 6:5
BRGT L1          ; 6:5
SET R0, 0        ; 6:5
L1:
ADD R1, R7, 104  ; 6:5
ST R1, R0        ; 6:5

; kernel k1_matmul: %3 = matmul  (t.tiny:7:5)
; grid: 4 blocks x 3 threads; 6 shared words per block; 5 registers (R5-R7 reserved, read-only)
SET R0, 0        ; 7:5
MUL R1, R5, 6    ; 7:5
ADD R1, R1, 104  ; 7:5
ADD R2, R6, 86   ; 7:5
ADD R3, R1, R6   ; 7:5
LD R3, R3        ; 7:5
SHST R6, R3      ; 7:5
ADD R3, R6, 3    ; 7:5
ADD R1, R1, R3   ; 7:5
LD R1, R1        ; 7:5
SHST R3, R1      ; 7:5
SYNCB            ; 7:5
SHLD R1, 0       ; 7:5
LD R3, R2        ; 7:5
MUL R4, R1, R3   ; 7:5
ADD R0, R0, R4   ; 7:5
ADD R2, R2, 3    ; 7:5
SHLD R1, 1       ; 7:5
LD R3, R2        ; 7:5
MUL R4, R1, R3   ; 7:5
ADD R0, R0, R4   ; 7:5
ADD R2, R2, 3    ; 7:5
SHLD R1, 2       ; 7:5
LD R3, R2        ; 7:5
MUL R4, R1, R3   ; 7:5
ADD R0, R0, R4   ; 7:5
ADD R2, R2, 3    ; 7:5
SHLD R1, 3       ; 7:5
LD R3, R2        ; 7:5
MUL R4, R1, R3   ; 7:5
ADD R0, R0, R4   ; 7:5
ADD R2, R2, 3    ; 7:5
SHLD R1, 4       ; 7:5
LD R3, R2        ; 7:5
MUL R4, R1, R3   ; 7:5
ADD R0, R0, R4   ; 7:5
ADD R2, R2, 3    ; 7:5
SHLD R1, 5       ; 7:5
LD R3, R2        ; 7:5
MUL R4, R1, R3   ; 7:5
ADD R0, R0, R4   ; 7:5
ADD R2, R2, 3    ; 7:5
ADD R1, R7, 128  ; 7:5
ST R1, R0        ; 7:5
