kernel @k0_matmul grid=(4 blocks, 4 threads)  // %2 = matmul at 5:5 {
  v0 = set 0
  for v1 in 0..8 {
    v2 = mul block, 8
    v2 = add v2, v1
    v2 = add v2, 0
    v3 = ld [v2]
    v4 = mul v1, 4
    v4 = add v4, thread
    v4 = add v4, 32
    v5 = ld [v4]
    v6 = mul v3, v5
    v0 = add v0, v6
  }
  v7 = add thread, 64
  v8 = ld [v7]
  v0 = add v0, v8
  if le v0, 0 {
    v0 = set 0
  }
  v9 = add tid, 68
  st [v9], v0
}
