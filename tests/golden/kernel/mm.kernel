kernel @k0_matmul grid=(4 blocks, 4 threads)  // %0 = matmul at 4:5 {
  v0 = set 0
  for v1 in 0..4 {
    v2 = mul block, 4
    v2 = add v2, v1
    v2 = add v2, 0
    v3 = ld [v2]
    v4 = mul v1, 4
    v4 = add v4, thread
    v4 = add v4, 16
    v5 = ld [v4]
    v6 = mul v3, v5
    v0 = add v0, v6
  }
  v7 = add tid, 32
  st [v7], v0
}
