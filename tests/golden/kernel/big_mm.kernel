kernel @k0_matmul grid=(12 blocks, 12 threads)  // %1 = matmul at 4:5 {
  v0 = set 0
  for v1 in 0..12 {
    v2 = mul block, 12
    v2 = add v2, v1
    v2 = add v2, 0
    v3 = ld [v2]
    v4 = mul v1, 12
    v4 = add v4, thread
    v4 = add v4, 144
    v5 = ld [v4]
    v6 = mul v3, v5
    v0 = add v0, v6
  }
  if le v0, 0 {
    v0 = set 0
  }
  v7 = add tid, 288
  st [v7], v0
}
