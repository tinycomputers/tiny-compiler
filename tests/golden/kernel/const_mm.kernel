kernel @k0_matmul grid=(3 blocks, 2 threads)  // %2 = matmul at 5:5 {
  v0 = set 0
  for v1 in 0..2 {
    v2 = mul block, 2
    v2 = add v2, v1
    v2 = add v2, 0
    v3 = ld [v2]
    v4 = mul v1, 2
    v4 = add v4, thread
    v4 = add v4, 6
    v5 = ld [v4]
    v6 = mul v3, v5
    v0 = add v0, v6
  }
  if le v0, 0 {
    v0 = set 0
  }
  v7 = add tid, 10
  st [v7], v0
}
