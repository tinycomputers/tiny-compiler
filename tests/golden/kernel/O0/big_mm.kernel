kernel @k0_matmul grid=(12 blocks, 12 threads)  // %0 = matmul at 4:10 {
  v0 = set 0
  for v1 in 0..12 {
    v2 = mul block, 12
    v3 = add v2, 0
    v4 = add v3, v1
    v5 = ld [v4]
    v6 = mul v1, 12
    v7 = add v6, thread
    v8 = add v7, 144
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
  }
  v11 = add tid, 288
  st [v11], v0
}

kernel @k1_relu grid=(12 blocks, 12 threads)  // %1 = relu at 4:5 {
  v0 = add tid, 288
  v1 = ld [v0]
  if le v1, 0 {
    v1 = set 0
  }
  v2 = add tid, 432
  st [v2], v1
}
