kernel @k0_matmul grid=(4 blocks, 6 threads)  // %0 = matmul at 6:10 {
  v0 = set 0
  for v1 in 0..8 {
    v2 = mul block, 8
    v3 = add v2, 0
    v4 = add v3, v1
    v5 = ld [v4]
    v6 = mul v1, 6
    v7 = add v6, thread
    v8 = add v7, 32
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
  }
  v11 = add tid, 104
  st [v11], v0
}

kernel @k1_add grid=(4 blocks, 6 threads)  // %1 = add at 6:10 {
  v0 = add tid, 104
  v1 = ld [v0]
  v2 = add thread, 80
  v3 = ld [v2]
  v4 = add v1, v3
  v5 = add tid, 128
  st [v5], v4
}

kernel @k2_relu grid=(4 blocks, 6 threads)  // %2 = relu at 6:5 {
  v0 = add tid, 128
  v1 = ld [v0]
  if le v1, 0 {
    v1 = set 0
  }
  v2 = add tid, 104
  st [v2], v1
}

kernel @k3_matmul grid=(4 blocks, 3 threads)  // %3 = matmul at 7:5 {
  v0 = set 0
  for v1 in 0..6 {
    v2 = mul block, 6
    v3 = add v2, 104
    v4 = add v3, v1
    v5 = ld [v4]
    v6 = mul v1, 3
    v7 = add v6, thread
    v8 = add v7, 86
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
  }
  v11 = add tid, 128
  st [v11], v0
}
