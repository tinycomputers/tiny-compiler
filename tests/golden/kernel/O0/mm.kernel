kernel @k0_matmul grid=(4 blocks, 4 threads)  // %0 = matmul at 4:5 {
  v0 = set 0
  for v1 in 0..4 {
    v2 = mul block, 4
    v3 = add v2, 0
    v4 = add v3, v1
    v5 = ld [v4]
    v6 = mul v1, 4
    v7 = add v6, thread
    v8 = add v7, 16
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
  }
  v11 = add tid, 32
  st [v11], v0
}
