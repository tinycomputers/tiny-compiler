kernel @k0_matmul grid=(3 blocks, 2 threads)  // %1 = matmul at 5:10 {
  v0 = set 0
  for v1 in 0..2 {
    v2 = mul block, 2
    v3 = add v2, 0
    v4 = add v3, v1
    v5 = ld [v4]
    v6 = mul v1, 2
    v7 = add v6, thread
    v8 = add v7, 6
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
  }
  v11 = add tid, 10
  st [v11], v0
}

kernel @k1_relu grid=(3 blocks, 2 threads)  // %2 = relu at 5:5 {
  v0 = add tid, 10
  v1 = ld [v0]
  if le v1, 0 {
    v1 = set 0
  }
  v2 = add tid, 16
  st [v2], v1
}
