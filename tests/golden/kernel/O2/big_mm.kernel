kernel @k0_matmul grid=(12 blocks, 12 threads) shared=12 words  // %1 = matmul at 4:5 {
  v0 = set 0
  v2 = mul block, 12
  v8 = add thread, 144
  v12 = add v2, thread
  v13 = ld [v12]
  shst [thread], v13
  syncb
  v5 = shld [0]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [1]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [2]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [3]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [4]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [5]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [6]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [7]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [8]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [9]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [10]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  v5 = shld [11]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 12
  if le v0, 0 {
    v0 = set 0
  }
  v11 = add tid, 288
  st [v11], v0
}
