kernel @k0_matmul grid=(3 blocks, 2 threads) shared=2 words  // %2 = matmul at 5:5 {
  v0 = set 0
  v2 = mul block, 2
  v8 = add thread, 6
  v12 = add v2, thread
  v13 = ld [v12]
  shst [thread], v13
  syncb
  v5 = shld [0]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 2
  v5 = shld [1]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 2
  if le v0, 0 {
    v0 = set 0
  }
  v11 = add tid, 10
  st [v11], v0
}
