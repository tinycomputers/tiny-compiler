kernel @k0_matmul grid=(4 blocks, 4 threads) shared=8 words  // %2 = matmul at 5:5 {
  v0 = set 0
  v2 = mul block, 8
  v8 = add thread, 32
  v14 = add v2, thread
  v15 = ld [v14]
  shst [thread], v15
  v16 = add thread, 4
  v17 = add v2, v16
  v18 = ld [v17]
  shst [v16], v18
  syncb
  v5 = shld [0]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v5 = shld [1]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v5 = shld [2]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v5 = shld [3]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v5 = shld [4]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v5 = shld [5]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v5 = shld [6]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v5 = shld [7]
  v9 = ld [v8]
  v10 = mul v5, v9
  v0 = add v0, v10
  v8 = add v8, 4
  v11 = add thread, 64
  v12 = ld [v11]
  v0 = add v0, v12
  if le v0, 0 {
    v0 = set 0
  }
  v13 = add tid, 68
  st [v13], v0
}
