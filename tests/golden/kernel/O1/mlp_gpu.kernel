kernel @k0_matmul grid=(4 blocks, 6 threads)  // %2 = matmul at 6:5 {
  v0 = set 0
  v2 = mul block, 8
  v3 = add v2, 0
  v8 = add thread, 32
  for v1 in 0..8 {
    v4 = add v3, v1
    v5 = ld [v4]
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
    v8 = add v8, 6
  }
  v11 = add thread, 80
  v12 = ld [v11]
  v0 = add v0, v12
  if le v0, 0 {
    v0 = set 0
  }
  v13 = add tid, 104
  st [v13], v0
}

kernel @k1_matmul grid=(4 blocks, 3 threads)  // %3 = matmul at 7:5 {
  v0 = set 0
  v2 = mul block, 6
  v3 = add v2, 104
  v8 = add thread, 86
  for v1 in 0..6 {
    v4 = add v3, v1
    v5 = ld [v4]
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
    v8 = add v8, 3
  }
  v11 = add tid, 128
  st [v11], v0
}
