kernel @k0_matmul grid=(12 blocks, 12 threads)  // %1 = matmul at 4:5 {
  v0 = set 0
  v2 = mul block, 12
  v3 = add v2, 0
  v8 = add thread, 144
  for v1 in 0..12 {
    v4 = add v3, v1
    v5 = ld [v4]
    v9 = ld [v8]
    v10 = mul v5, v9
    v0 = add v0, v10
    v8 = add v8, 12
  }
  if le v0, 0 {
    v0 = set 0
  }
  v11 = add tid, 288
  st [v11], v0
}
